### Configurações Globais
@baseUrl = http://localhost:3000
@contentType = application/json

### ----------------------------------------------------
### AUTENTICAÇÃO
### ----------------------------------------------------

# @name loginAdmin
# Realizar login para obter o token do administrador
POST {{baseUrl}}/login
Content-Type: {{contentType}}

{
  "email": "admin@exemplo.com",
  "password": "senhaAdmin123"
}

###

# @name loginAdopter
# Realizar login para obter o token de um adotante comum
POST {{baseUrl}}/login
Content-Type: {{contentType}}

{
  "email": "adopter@exemplo.com",
  "password": "senhaAdopter123"
}

### ----------------------------------------------------
### CONFIGURAÇÃO DOS TOKENS AUTOMÁTICOS
### ----------------------------------------------------
@tokenAdmin = {{loginAdmin.response.body.token}}
@tokenAdopter = {{loginAdopter.response.body.token}}

### ----------------------------------------------------
### ROTAS DE SUCESSO
### ----------------------------------------------------

# Listar pets disponíveis (Rota pública)
GET {{baseUrl}}/pets/available

###

# Criar novo pet (Apenas Admin)
# @name criarPet
POST {{baseUrl}}/pets
Authorization: Bearer {{tokenAdmin}}
Content-Type: {{contentType}}

{
  "name": "Mima",
  "age": 2,
  "species": "Gato",
  "size": "medium",
  "description": "Fofa e brincalhona, adora carinho e atenção."
}

###

# Listar todos os pets (Apenas Admin)
GET {{baseUrl}}/pets
Authorization: Bearer {{tokenAdmin}}

###

# Buscar pet por ID (Apenas Admin)
GET {{baseUrl}}/pets/1
Authorization: Bearer {{tokenAdmin}}

###

# Atualizar dados do pet (Apenas Admin)
PUT {{baseUrl}}/pets/1
Authorization: Bearer {{tokenAdmin}}
Content-Type: {{contentType}}

{
  "age": 3
}

### ----------------------------------------------------
### CENÁRIOS DE ERRO - PETS
### ----------------------------------------------------

# 1. Erro na Criação: Campo obrigatório ausente
POST {{baseUrl}}/pets
Authorization: Bearer {{tokenAdmin}}
Content-Type: {{contentType}}

{
  "age": 1,
  "species": "Gato",
  "size": "small"
}

###

# 2. Erro na Criação: Tamanho inválido
POST {{baseUrl}}/pets
Authorization: Bearer {{tokenAdmin}}
Content-Type: {{contentType}}

{
  "name": "Rex",
  "age": 4,
  "species": "Cachorro",
  "size": "giant"
}

###

# 3. Erro na Criação: Idade negativa
POST {{baseUrl}}/pets
Authorization: Bearer {{tokenAdmin}}
Content-Type: {{contentType}}

{
  "name": "Baleia",
  "age": -1,
  "species": "Gato",
  "size": "small"
}

###

# 4. Erro de Autorização: Adotante tentando criar um pet
POST {{baseUrl}}/pets
Authorization: Bearer {{tokenAdopter}}
Content-Type: {{contentType}}

{
  "name": "Pipoca",
  "age": 1,
  "species": "Hamster",
  "size": "small"
}

###

# 5. Erro de Busca: Pet com ID inexistente
GET {{baseUrl}}/pets/999999
Authorization: Bearer {{tokenAdmin}}

###

# 6. Erro de Deleção: Pet já adotado
DELETE {{baseUrl}}/pets/9
Authorization: Bearer {{tokenAdmin}}
